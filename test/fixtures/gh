#!/bin/sh
# Stands in for the GitHub CLI. Responses come from $FAKE_GH_DIR, which the test
# writes, so a case can describe the GitHub it needs rather than share fixtures.
set -e
case "$*" in
  # The floor `doctor` holds gh to. A stand-in that cannot say which gh it is
  # would be reported as one Engwire cannot read paginated responses from.
  --version) echo "gh version 2.31.0 (2023-06-06)" ;;
  "api user --jq .login")
    # A GitHub outage looks like a non-zero `gh`, not a missing account.
    [ -n "$FAKE_GH_FAIL_LOGIN" ] && { echo "could not resolve host" >&2; exit 1; }
    # A `gh` that has not answered yet, so a test can signal the runner while
    # one is genuinely in flight rather than racing to guess when it is.
    [ -n "$FAKE_GH_HANG_LOGIN" ] && { : > "$FAKE_GH_HANG_LOGIN"; sleep 120; }
    echo "${FAKE_GH_LOGIN:-me}" ;;
  search*)                cat "$FAKE_GH_DIR/search.json" ;;
  "pr view"*)             cat "$FAKE_GH_DIR/pr.json" ;;
  *"/events"*)
    # `repos/<owner>/<name>/issues/<n>/events`. A case that needs two
    # repositories gives each its own file; everything else shares one.
    repo=$(printf '%s' "$*" | sed -n 's|.*repos/\([^/]*\)/\([^/]*\)/.*|\1-\2|p')
    if [ -f "$FAKE_GH_DIR/events-$repo.json" ]
    then cat "$FAKE_GH_DIR/events-$repo.json"
    else cat "$FAKE_GH_DIR/events.json"
    fi ;;
  *) echo "fake gh: unexpected invocation: $*" >&2; exit 64 ;;
esac
